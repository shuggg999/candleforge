<?xml version="1.0"?>
<clickhouse>
    <!-- Network settings -->
    <max_concurrent_queries>100</max_concurrent_queries>
    <max_connections>1024</max_connections>
    
    <!-- Skip setting validation for simplicity -->
    <skip_check_for_incorrect_settings>1</skip_check_for_incorrect_settings>
    
    <!-- Compression -->
    <compression>
        <case>
            <method>lz4</method>
        </case>
    </compression>
    
    <!-- Merge tree settings for better performance -->
    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>10737418240</max_bytes_to_merge_at_max_space_in_pool>
        <max_bytes_to_merge_at_min_space_in_pool>1073741824</max_bytes_to_merge_at_min_space_in_pool>
        <parts_to_delay_insert>150</parts_to_delay_insert>
        <parts_to_throw_insert>300</parts_to_throw_insert>
        <max_delay_to_insert>1</max_delay_to_insert>
        <min_merge_bytes_to_use_direct_io>1073741824</min_merge_bytes_to_use_direct_io>
    </merge_tree>
    
    <!-- Log settings -->
    <logger>
        <level>information</level>
        <console>true</console>
    </logger>
    
    <!-- User profiles with performance settings -->
    <profiles>
        <default>
            <max_memory_usage>6442450944</max_memory_usage> <!-- 6GB -->
            <max_threads>8</max_threads>
            <max_block_size>65536</max_block_size>
            <max_insert_block_size>1048576</max_insert_block_size>
        </default>
    </profiles>
    
    <!-- Users configuration -->
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>
    
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>