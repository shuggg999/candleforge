//@version=6
strategy("WhoAreU？你是谁", overlay=true, margin_long=20, margin_short=20, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.075, max_bars_back=5000, calc_on_every_tick=true)

// === 输入参数 ===
// 赛博朋克主题颜色
cyberPink = #FF00FF, cyberBlue = #00FFFF, cyberPurple = #9933FF, cyberYellow = #FFFF00, cyberGreen = #00FF99, cyberRed = #FF3366, cyberBackground = #0D0221, cyberGrid = #3A1C71

// 基本指标
fastEMA = input.int(3, "快速EMA长度", minval=1, maxval=20, group="基本指标")
slowEMA = input.int(8, "慢速EMA长度", minval=2, maxval=50, group="基本指标")
trendEMA = input.int(55, "趋势EMA长度", minval=10, maxval=200, group="基本指标")
atrPeriod = input.int(14, "ATR周期", minval=1, maxval=50, group="基本指标")
tradeInterval = input.int(5, "交易间隔(分钟)", minval=1, maxval=1440, group="基本指标") // 减少间隔以增加交易频率

// 风险管理
slMultiplier = input.float(1.5, "止损倍数(ATR)", minval=0.5, maxval=5.0, step=0.1, group="风险管理") // 减小止损距离
tpMultiplier = input.float(2.5, "止盈倍数(ATR)", minval=0.5, maxval=10.0, step=0.1, group="风险管理") // 减小止盈距离
riskPct = input.float(1.5, "每笔交易风险(%)", minval=0.1, maxval=10.0, step=0.1, group="风险管理") // 减少单笔风险
leverage = input.float(10.0, "杠杆倍数", minval=1.0, maxval=20.0, step=1.0, group="风险管理") // 增加杠杆

// 自适应设置
useAdaptive = input.bool(true, "使用自适应模式", group="自适应设置")
adaptivePeriod = input.int(14, "自适应周期", group="自适应设置")

// 交易量过滤器
useVolumeFilter = input.bool(true, "启用交易量过滤", group="交易量过滤")
volumePeriod = input.int(20, "交易量均线周期", minval=5, maxval=50, group="交易量过滤")
volumeThreshold = input.float(1.05, "交易量阈值倍数", minval=1.0, maxval=5.0, step=0.05, group="交易量过滤") // 降低阈值增加交易机会

// 视觉效果
showLabels = input.bool(true, "显示标签", group="视觉效果")
showTable = input.bool(true, "显示性能表格", group="视觉效果")
lineWidth = input.int(2, "线条宽度", minval=1, maxval=4, group="视觉效果")
showShortPerspective = input.bool(true, "显示做空方视角", group="视觉效果")
labelOffset = input.float(0.2, "标签偏移量", minval=0.1, maxval=1.0, step=0.1, group="视觉效果") // 控制标签与K线的距离
labelSpacing = input.float(0.5, "标签间距", minval=0.1, maxval=1.0, step=0.1, group="视觉效果") // 控制标签之间的间距
labelOpacity = input.int(70, "标签透明度", minval=0, maxval=100, step=5, group="视觉效果") // 控制标签的透明度
glowEffect = input.bool(true, "启用霓虹发光效果", group="视觉效果")
animationSpeed = input.int(3, "动画速度", minval=1, maxval=10, group="视觉效果")

// 颜色设置 - 赛博朋克主题
fastColor = input.color(cyberBlue, "快速EMA颜色", group="颜色设置")
slowColor = input.color(cyberPink, "慢速EMA颜色", group="颜色设置")
trendColor = input.color(cyberPurple, "趋势EMA颜色", group="颜色设置")
bullColor = input.color(cyberGreen, "看涨颜色", group="颜色设置")
bearColor = input.color(cyberRed, "看跌颜色", group="颜色设置")

// === 回测模式设置 ===
backTestMode = input.string("市价模式", "回测模式", options=["市价模式", "限价模式"], group="回测设置")
showBacktestInfo = input.bool(true, "显示回测信息", group="回测设置")
entryPriceRatio = input.float(0.6, "入场价比例", minval=0.1, maxval=0.9, step=0.1, tooltip="入场价在做空止盈与多头建议入场之间的位置 (0.5=中间)", group="回测设置")
exitPriceRatio = input.float(0.4, "卖出价比例", minval=0.1, maxval=0.9, step=0.1, tooltip="卖出价在多头止盈与做空止损之间的位置 (0.5=中间)", group="回测设置")

// === 动态止盈止损设置 ===
dynamicSL = input.bool(false, "启用动态止损", group="动态止盈止损")
dynamicTP = input.bool(false, "启用动态止盈", group="动态止盈止损")
trailingSL = input.float(1.0, "追踪止损ATR倍数", minval=0.5, maxval=5.0, step=0.1, group="动态止盈止损")
breakEvenPct = input.float(0.5, "保本触发比例", minval=0.1, maxval=1.0, step=0.1, group="动态止盈止损")

// === 市场情绪分析 ===
useSentimentAnalysis = input.bool(true, "启用市场情绪分析", group="市场情绪")
sentimentPeriod = input.int(20, "情绪分析周期", minval=10, maxval=50, group="市场情绪")
sentimentWeight = input.float(0.3, "情绪权重", minval=0.1, maxval=1.0, step=0.1, group="市场情绪")

// === 波动率过滤器 ===
useVolatilityFilter = input.bool(true, "启用波动率过滤", group="波动率过滤")
volatilityPeriod = input.int(10, "波动率周期", minval=5, maxval=30, group="波动率过滤")
volatilityThreshold = input.float(1.0, "波动率阈值", minval=0.8, maxval=2.0, step=0.1, group="波动率过滤") // 降低阈值增加交易机会

// === 高频交易设置 ===
enableHighFrequency = input.bool(true, "启用高频交易模式", group="高频交易")
hfSensitivity = input.float(0.8, "高频灵敏度", minval=0.5, maxval=1.0, step=0.05, group="高频交易") // 控制高频交易的灵敏度
hfMinProfit = input.float(0.3, "高频最小利润(%)", minval=0.1, maxval=1.0, step=0.1, group="高频交易") // 高频交易的最小利润目标

// === 支撑阻力位设置 ===
showSR = input.bool(true, "显示支撑阻力位", group="支撑阻力位")
srPeriod = input.int(20, "支撑阻力位周期", minval=10, maxval=50, group="支撑阻力位")
srDeviation = input.float(1.5, "支撑阻力位偏差", minval=0.5, maxval=3.0, step=0.1, group="支撑阻力位")

// === 未来预测设置 ===
showPrediction = input.bool(true, "显示未来预测", group="未来预测")
predictionPeriod = input.int(5, "预测周期", minval=3, maxval=20, group="未来预测")

// === 认知偏差分析 ===
useCognitiveBias = input.bool(true, "启用认知偏差分析", group="认知偏差分析")
framingEffectPeriod = input.int(10, "框架效应周期", minval=5, maxval=30, group="认知偏差分析")
recencyBiasPeriod = input.int(5, "近因偏差周期", minval=3, maxval=15, group="认知偏差分析")

// === 反身性分析 ===
useReflexivity = input.bool(true, "启用反身性分析", group="反身性分析")
reflexivityPeriod = input.int(20, "反身性周期", minval=10, maxval=50, group="反身性分析")
reflexivityThreshold = input.float(0.6, "反身性阈值", minval=0.3, maxval=1.0, step=0.1, group="反身性分析")

// === 恐惧贪婪指数 ===
useFearGreedIndex = input.bool(true, "启用恐惧贪婪指数", group="恐惧贪婪指数")
fgPeriod = input.int(14, "恐惧贪婪周期", minval=7, maxval=30, group="恐惧贪婪指数")
fgThreshold = input.float(0.7, "恐惧贪婪阈值", minval=0.5, maxval=0.9, step=0.1, group="恐惧贪婪指数")

// === 添加过度延伸和超买检测 ===
overExtendedPeriod = input.int(20, "过度延伸检测周期", minval=10, maxval=50, group="风险控制")
adxPeriod = input.int(14, "ADX周期", minval=5, maxval=30, group="风险控制")
adxThreshold = input.float(40, "ADX阈值", minval=20, maxval=60, step=5, group="风险控制")
maxRSIThreshold = input.float(75, "RSI超买阈值", minval=40, maxval=90, step=5, group="风险控制")
priceSpikeThreshold = input.float(4.0, "价格飙升ATR倍数", minval=2.0, maxval=10.0, step=0.5, group="风险控制")
maxDrawdownLimit = input.float(25.0, "最大回撤限制(%)", minval=5.0, maxval=50.0, step=5.0, group="风险控制")
enableDrawdownControl = input.bool(true, "启用回撤控制", group="风险控制")

// === 霓虹发光效果函数 ===
getNeonColor(baseColor, time) => glowEffect ? color.rgb(math.round(color.r(baseColor) + (255 - color.r(baseColor)) * (math.sin(time / 10 * animationSpeed) * 0.5 + 0.5) * 0.3), math.round(color.g(baseColor) + (255 - color.g(baseColor)) * (math.sin(time / 10 * animationSpeed) * 0.5 + 0.5) * 0.3), math.round(color.b(baseColor) + (255 - color.b(baseColor)) * (math.sin(time / 10 * animationSpeed) * 0.5 + 0.5) * 0.3)) : baseColor

// === 标签绘制函数 - 赛博朋克风格 ===
drawCyberLabel(x, y, labelText, bgColor, txtColor, labelStyle, labelSize) => label.new(x=x, y=y, text=labelText, color=getNeonColor(bgColor, time), textcolor=txtColor, style=labelStyle, size=labelSize, xloc=xloc.bar_time, textalign=text.align_left)

// === 计算指标 ===
fastLine = ta.ema(close, fastEMA)
slowLine = ta.ema(close, slowEMA)
trendLine = ta.ema(close, trendEMA)
atrValue = ta.atr(atrPeriod)

// 交易量指标
volumeMA = ta.sma(volume, volumePeriod)
volumeRatio = volume / volumeMA
volumeCondition = volume > volumeMA * volumeThreshold

// 波动率指标
volatility = ta.stdev(close, volatilityPeriod) / ta.sma(close, volatilityPeriod) * 100
volatilityCondition = volatility > volatilityThreshold

// 趋势检测
rsiValue = ta.rsi(close, adaptivePeriod)
trendStrength = math.abs(rsiValue - 50) / 50
isTrending = trendStrength > 0.2 * hfSensitivity // 降低趋势阈值增加交易机会
uptrend = ta.sma(close, 5) > ta.sma(close, 20)
downtrend = ta.sma(close, 5) < ta.sma(close, 20)

// === 认知偏差分析 ===
// 框架效应 - 分析价格相对于近期高低点的位置如何影响决策
recentHigh = ta.highest(high, framingEffectPeriod)
recentLow = ta.lowest(low, framingEffectPeriod)
priceRange = recentHigh - recentLow
relativePosition = (close - recentLow) / (priceRange > 0 ? priceRange : 1)
framingEffect = relativePosition > 0.7 ? -0.5 : relativePosition < 0.3 ? 0.5 : 0

// 近因偏差 - 最近几根K线的走势对决策的影响
recentBullish = 0
recentBearish = 0

for i = 0 to recencyBiasPeriod - 1
    if close[i] > open[i]
        recentBullish := recentBullish + 1
    else if close[i] < open[i]
        recentBearish := recentBearish + 1

recencyBias = (recentBullish - recentBearish) / recencyBiasPeriod

// 锚定效应 - 使用开盘价作为锚点
anchoringBias = (close - open) / open

// 元认知偏差分数 - 综合多种认知偏差
metaBiasScore = framingEffect + recencyBias + anchoringBias

// === 反身性分析 ===
// 价格动量与交易量的关系
priceChange = ta.change(close, reflexivityPeriod) / close[reflexivityPeriod] * 100
volumeChange = ta.change(volume, reflexivityPeriod) / volume[reflexivityPeriod] * 100

// 反身性指标 - 价格变化与交易量变化的协同效应
reflexivityScore = priceChange * volumeChange > 0 ? math.abs(priceChange * volumeChange) / 100 : -math.abs(priceChange * volumeChange) / 100

// 多时间框架反身性
shortTermReflexivity = ta.change(close, 5) / close[5] * 100
mediumTermReflexivity = ta.change(close, 20) / close[20] * 100
longTermReflexivity = ta.change(close, 50) / close[50] * 100

// 反身性对齐度 - 检查不同时间框架的趋势是否一致
reflexivityAlignment = (math.sign(shortTermReflexivity) == math.sign(mediumTermReflexivity) and math.sign(mediumTermReflexivity) == math.sign(longTermReflexivity)) ? math.abs(shortTermReflexivity + mediumTermReflexivity + longTermReflexivity) / 3 : 0

// === 恐惧贪婪指数 ===
// 基于RSI、波动率和成交量的恐惧贪婪指标
rsiComponent = (rsiValue - 50) / 50  // -1到1之间
volatilityComponent = (volatility - ta.sma(volatility, fgPeriod)) / ta.sma(volatility, fgPeriod)
volumeComponent = (volumeRatio - 1) * 0.5

// 综合恐惧贪婪指数 (-1到1，-1表示极度恐惧，1表示极度贪婪)
fearGreedIndex = (rsiComponent + volatilityComponent + volumeComponent) / 3

// 恐惧贪婪状态
fgState = fearGreedIndex > 0.7 ? "极度贪婪" : fearGreedIndex > 0.3 ? "贪婪" : fearGreedIndex > -0.3 ? "中性" : fearGreedIndex > -0.7 ? "恐惧" : "极度恐惧"

// === 计算风险指标 ===
// ADX计算
[diplus, diminus, adx] = ta.dmi(adxPeriod, adxPeriod)
// 注意：adx已经是0-100范围内的值，不需要再乘以100

// 检测价格是否过度延伸
pricePercentChange = (close - ta.sma(close, overExtendedPeriod)) / ta.sma(close, overExtendedPeriod) * 100
distanceFromHigh = (recentHigh - close) / close * 100

// 检测价格飙升速度
priceChange5 = (close - close[5]) / close[5] * 100
priceChangeAtr = (close - close[5]) / atrValue

// 检测是否处于瀑布行情前的超买状态
isOverbought = rsiValue > maxRSIThreshold
isPriceOverextended = pricePercentChange > 15 or priceChangeAtr > priceSpikeThreshold
isVolatilityHigh = volatility > volatilityThreshold * 1.5
isAdxHigh = adx > adxThreshold  // 强趋势可能即将反转
isNearRecentHigh = distanceFromHigh < 1.0  // 接近近期最高点

// 计算风险评分 (0-100)
riskScore = 0.0
if isOverbought
    riskScore := riskScore + 25
if isPriceOverextended
    riskScore := riskScore + 20
if isVolatilityHigh
    riskScore := riskScore + 15
if isAdxHigh
    riskScore := riskScore + 20
if isNearRecentHigh
    riskScore := riskScore + 20

// 定义风险级别
riskLevel = riskScore >= 80 ? "极高风险" : riskScore >= 60 ? "高风险" : riskScore >= 40 ? "中等风险" : riskScore >= 20 ? "低风险" : "安全"
riskColor = riskScore >= 80 ? color.rgb(255, 0, 0) : riskScore >= 60 ? getNeonColor(cyberRed, time) : riskScore >= 40 ? color.rgb(255, 165, 0) : riskScore >= 20 ? color.rgb(255, 255, 0) : getNeonColor(cyberGreen, time)

// === 回撤控制功能 ===
// 跟踪全局最大权益和当前回撤
var float globalPeakEquity = 0.0
globalPeakEquity := math.max(globalPeakEquity, strategy.equity)
currentGlobalDrawdown = (globalPeakEquity - strategy.equity) / globalPeakEquity * 100

// 趋势可能性评估
uptrendProb = 0.0
downtrendProb = 0.0

// 计算多头趋势可能性 (0-100%)
if uptrend
    uptrendProb := uptrendProb + 30
if rsiValue > 50
    uptrendProb := uptrendProb + 20
if fastLine > slowLine
    uptrendProb := uptrendProb + 20
if close > trendLine
    uptrendProb := uptrendProb + 15
if volumeRatio > 1.0
    uptrendProb := uptrendProb + 15

// 认知偏差和反身性分析的影响
if useCognitiveBias
    uptrendProb := uptrendProb + (metaBiasScore > 0 ? metaBiasScore * 10 : 0)
if useReflexivity
    uptrendProb := uptrendProb + (reflexivityScore > 0 ? reflexivityScore * 10 : 0)
if useFearGreedIndex
    uptrendProb := uptrendProb + (fearGreedIndex > 0 ? fearGreedIndex * 10 : 0)

// 计算空头趋势可能性 (0-100%)
if downtrend
    downtrendProb := downtrendProb + 30
if rsiValue < 50
    downtrendProb := downtrendProb + 20
if fastLine < slowLine
    downtrendProb := downtrendProb + 20
if close < trendLine
    downtrendProb := downtrendProb + 15
if volumeRatio < 1.0
    downtrendProb := downtrendProb + 15

// 认知偏差和反身性分析的影响
if useCognitiveBias
    downtrendProb := downtrendProb + (metaBiasScore < 0 ? -metaBiasScore * 10 : 0)
if useReflexivity
    downtrendProb := downtrendProb + (reflexivityScore < 0 ? -reflexivityScore * 10 : 0)
if useFearGreedIndex
    downtrendProb := downtrendProb + (fearGreedIndex < 0 ? -fearGreedIndex * 10 : 0)

// 限制在0-100范围内
uptrendProb := math.min(math.max(uptrendProb, 0), 100)
downtrendProb := math.min(math.max(downtrendProb, 0), 100)

// 趋势状态文本
trendStatusText = uptrendProb > 70 ? "强势上涨" : uptrendProb > 50 ? "温和上涨" : downtrendProb > 70 ? "强势下跌" : downtrendProb > 50 ? "温和下跌" : "盘整"

// 市场情绪分析
bullishCandles = 0
bearishCandles = 0
neutralCandles = 0

for i = 0 to sentimentPeriod - 1
    if close[i] > open[i] * 1.005  // 明显的阳线
        bullishCandles := bullishCandles + 1
    else if close[i] < open[i] * 0.995  // 明显的阴线
        bearishCandles := bearishCandles + 1
    else
        neutralCandles := neutralCandles + 1

sentimentScore = (bullishCandles - bearishCandles) / sentimentPeriod
sentimentBias = sentimentScore > 0.3 ? "强烈看多" : sentimentScore > 0.1 ? "轻度看多" : sentimentScore < -0.3 ? "强烈看空" : sentimentScore < -0.1 ? "轻度看空" : "中性"

// 超买超卖检测
overbought = rsiValue > 70
oversold = rsiValue < 30

// === 计算支撑阻力位 ===
// 使用固定周期计算支撑阻力位，避免漂移
highestHigh = ta.highest(high, srPeriod)
lowestLow = ta.lowest(low, srPeriod)

// 计算局部高点和低点的指标
high5 = ta.highest(high[1], 5)
high10 = ta.highest(high[6], 5)
low5 = ta.lowest(low[1], 5)
low10 = ta.lowest(low[6], 5)

// 寻找局部高点和低点
isLocalHigh = high > high5 and high > high10
isLocalLow = low < low5 and low < low10

// 计算支撑位和阻力位
var float[] resistanceLevels = array.new_float(0)
var float[] supportLevels = array.new_float(0)

// 更新支撑阻力位
if isLocalHigh
    array.push(resistanceLevels, high)
    // 保持数组大小不超过5个元素
    if array.size(resistanceLevels) > 5
        array.shift(resistanceLevels)

if isLocalLow
    array.push(supportLevels, low)
    // 保持数组大小不超过5个元素
    if array.size(supportLevels) > 5
        array.shift(supportLevels)

// 找到最近的支撑位和阻力位
nearestResistance = highestHigh
nearestSupport = lowestLow

if array.size(resistanceLevels) > 0
    for i = 0 to array.size(resistanceLevels) - 1
        level = array.get(resistanceLevels, i)
        if level > close and level < nearestResistance
            nearestResistance := level

if array.size(supportLevels) > 0
    for i = 0 to array.size(supportLevels) - 1
        level = array.get(supportLevels, i)
        if level < close and level > nearestSupport
            nearestSupport := level

// 计算突破和支撑信号
breakoutSignal = close > nearestResistance * 0.995
supportSignal = close < nearestSupport * 1.005

// === 未来预测 ===
// 使用简单的线性回归预测未来价格
// 计算线性回归
x_sum = 0.0
y_sum = 0.0
xy_sum = 0.0
x2_sum = 0.0

for i = 0 to predictionPeriod - 1
    x_sum := x_sum + i
    y_sum := y_sum + close[i]
    xy_sum := xy_sum + (i * close[i])
    x2_sum := x2_sum + (i * i)

n = predictionPeriod
slope = (n * xy_sum - x_sum * y_sum) / (n * x2_sum - x_sum * x_sum)
intercept = (y_sum - slope * x_sum) / n

// 预测未来价格
predictedPrice = intercept + slope * (predictionPeriod + 1)

// 预测未来趋势
predictedTrend = slope > 0 ? "上涨" : "下跌"
predictedStrength = math.abs(slope) / close * 100

// 预测下一个交易机会
nextOpportunityText = predictedTrend == "上涨" and uptrendProb > 60 ? "看多机会: 价格回调至 " + str.tostring(math.round(nearestSupport, 4)) + " 附近" : predictedTrend == "下跌" and downtrendProb > 60 ? "看空机会: 价格反弹至 " + str.tostring(math.round(nearestResistance, 4)) + " 附近" : predictedTrend == "上涨" and breakoutSignal ? "突破确认: 等待回测 " + str.tostring(math.round(nearestResistance, 4)) + " 做多" : predictedTrend == "下跌" and supportSignal ? "支撑破位: 等待回测 " + str.tostring(math.round(nearestSupport, 4)) + " 做空" : "等待更明确的信号"

// === 绘制主要指标线 - 赛博朋克风格 ===
// 应用霓虹发光效果
fastLineColor = getNeonColor(fastColor, time)
slowLineColor = getNeonColor(slowColor, time)
trendLineColor = getNeonColor(trendColor, time)

// 使用plot.style_line确保线条与价格图表同步，并设置为extend.none避免延伸
plot(trendLine, "趋势EMA", color=trendLineColor, linewidth=lineWidth, style=plot.style_line)
plot(slowLine, "慢速EMA", color=slowLineColor, linewidth=lineWidth, style=plot.style_line)
plot(fastLine, "快速EMA", color=fastLineColor, linewidth=lineWidth, style=plot.style_line)

// 绘制支撑阻力位 - 使用plot.style_line确保线条与价格图表同步
resistanceColor = getNeonColor(bearColor, time)
supportColor = getNeonColor(bullColor, time)
resistancePlot = plot(nearestResistance, "阻力位", color=color.new(resistanceColor, 50), style=plot.style_line, linewidth=2)
supportPlot = plot(nearestSupport, "支撑位", color=color.new(supportColor, 50), style=plot.style_line, linewidth=2)

// 填充支撑阻力区域 - 赛博朋克风格
fill(resistancePlot, supportPlot, color=color.new(cyberPurple, 90), title="支撑阻力区域")

// === 交叉检测 ===
crossUp = ta.crossover(fastLine, slowLine)
crossDown = ta.crossunder(fastLine, slowLine)

// === 交易量可视化 - 赛博朋克风格 ===
volumeBarColor = volumeRatio > volumeThreshold ? color.new(getNeonColor(bullColor, time), 70) : color.new(getNeonColor(bearColor, time), 70)
barcolor(volumeBarColor)

// === 智能限价计算 ===
// 更新多头建议价格和做空方价格
var float suggestedEntryPrice = 0.0
var float suggestedStopLossPrice = 0.0
var float suggestedTakeProfitPrice = 0.0
var float shortEntryPrice = 0.0
var float shortStopPrice = 0.0
var float shortTPPrice = 0.0
var float smartEntryPrice = 0.0
var float smartExitPrice = 0.0

// 多头建议价格
suggestedEntryPrice := close
suggestedStopLossPrice := close - (atrValue * slMultiplier)
suggestedTakeProfitPrice := close + (atrValue * tpMultiplier)

// 做空方价格
shortEntryPrice := close
shortStopPrice := close + (atrValue * slMultiplier)
shortTPPrice := close - (atrValue * tpMultiplier)

// 计算智能限价
smartEntryPrice := shortTPPrice + (suggestedEntryPrice - shortTPPrice) * entryPriceRatio
smartExitPrice := suggestedTakeProfitPrice + (shortStopPrice - suggestedTakeProfitPrice) * exitPriceRatio

// === 交易逻辑 ===
var int lastTradeBarIndex = 0
timeElapsed = (bar_index - lastTradeBarIndex) >= tradeInterval
noActivePosition = strategy.position_size == 0

// 仓位计算
riskAmount = strategy.equity * (riskPct / 100)
stopDistance = atrValue * slMultiplier
positionSize = math.round((riskAmount / stopDistance) * leverage)

// 入场条件 - 仅做多
longTrendEntry = crossUp and close > trendLine and uptrend and isTrending
longCounterEntry = crossUp and close < trendLine and not isTrending and oversold // 增加超卖条件提高反转交易质量

// 额外的入场条件 - 增加交易频率
extraLongEntry = fastLine > slowLine and close > fastLine and uptrend and volumeCondition and timeElapsed and noActivePosition

// 高频交易条件
highFreqEntry = enableHighFrequency and noActivePosition and timeElapsed and (close > fastLine) and (fastLine > slowLine) and (volumeRatio > 1.0 * hfSensitivity) and (rsiValue > 45 * hfSensitivity) and (rsiValue < 75)

// 认知偏差和反身性增强的入场条件
cognitiveBiasEntry = useCognitiveBias and metaBiasScore > 0.5 and recencyBias > 0.3
reflexivityEntry = useReflexivity and reflexivityScore > reflexivityThreshold and reflexivityAlignment > 0
fearGreedEntry = useFearGreedIndex and fearGreedIndex > 0 and fearGreedIndex < fgThreshold

// 市场情绪过滤
sentimentFilter = useSentimentAnalysis ? sentimentScore > -0.2 * hfSensitivity : true  // 避免在强烈看空情绪下做多

// 波动率过滤
volatilityFilter = useVolatilityFilter ? volatilityCondition : true

// 最终入场信号 - 仅做多
validLong = ((useAdaptive ? (isTrending ? longTrendEntry : longCounterEntry) : crossUp) or extraLongEntry or highFreqEntry or (cognitiveBiasEntry and reflexivityEntry and fearGreedEntry)) and timeElapsed and noActivePosition and (useVolumeFilter ? volumeRatio > volumeThreshold * hfSensitivity : true) and sentimentFilter and volatilityFilter

// 风险调整信号
// 根据风险评分调整信号
validLongAfterRisk = validLong
if riskScore >= 60  // 高风险或极高风险条件下
    validLongAfterRisk := false  // 禁止做多信号

// 根据回撤控制调整
if enableDrawdownControl and currentGlobalDrawdown > maxDrawdownLimit
    validLongAfterRisk := false  // 超过最大回撤限制时禁止新的多头信号

// 做空方视角分析
shortPressure = 0.0
shortConfidence = ""
shortReason = ""

// 计算做空压力指数 (0-100)
if downtrend
    shortPressure := shortPressure + 30
if overbought
    shortPressure := shortPressure + 25
if crossDown
    shortPressure := shortPressure + 20
if close < trendLine
    shortPressure := shortPressure + 15
if volumeRatio < 0.8
    shortPressure := shortPressure + 10

// 认知偏差和反身性分析的影响
if useCognitiveBias and metaBiasScore < -0.3
    shortPressure := shortPressure + 10
if useReflexivity and reflexivityScore < -reflexivityThreshold
    shortPressure := shortPressure + 10
if useFearGreedIndex and fearGreedIndex < -0.5
    shortPressure := shortPressure + 10

// 限制在0-100范围内
shortPressure := math.min(math.max(shortPressure, 0), 100)

// 确定做空信心级别
shortConfidence := shortPressure >= 80 ? "极高" : shortPressure >= 60 ? "高" : shortPressure >= 40 ? "中等" : shortPressure >= 20 ? "低" : "极低"

// 确定做空理由
shortReason := downtrend and overbought ? "超买 + 下降趋势" : downtrend ? "下降趋势" : overbought ? "超买状态" : crossDown ? "EMA死叉" : close < trendLine ? "价格低于趋势线" : metaBiasScore < -0.5 ? "认知偏差负向" : reflexivityScore < -reflexivityThreshold ? "反身性负向" : fearGreedIndex < -0.5 ? "极度恐惧" : "无明显理由"

// === 交易执行 ===
var float entryPrice = 0.0
var float stopLossPrice = 0.0
var float takeProfitPrice = 0.0
var float maxPrice = 0.0  // 用于追踪最高价格

if validLongAfterRisk  // 使用经过风险评估的信号
    // 高频模式下使用更小的止盈止损
    actualSlMultiplier = highFreqEntry ? slMultiplier * 0.8 : slMultiplier
    actualTpMultiplier = highFreqEntry ? tpMultiplier * 0.8 : tpMultiplier

    // 认知偏差和反身性分析调整止盈止损
    if useCognitiveBias and metaBiasScore > 0.5
        actualTpMultiplier := actualTpMultiplier * 1.2  // 增加止盈目标
    if useReflexivity and reflexivityScore > reflexivityThreshold
        actualTpMultiplier := actualTpMultiplier * 1.1  // 增加止盈目标
    if useFearGreedIndex and fearGreedIndex > 0.5
        actualSlMultiplier := actualSlMultiplier * 1.2  // 增加止损距离，防止过早止损

    stopPrice = close - (atrValue * actualSlMultiplier)
    tpPrice = close + (atrValue * actualTpMultiplier)

    // 保存入场价格和初始止损止盈价格
    entryPrice := backTestMode == "市价模式" ? close : smartEntryPrice
    stopLossPrice := stopPrice
    takeProfitPrice := backTestMode == "市价模式" ? tpPrice : smartExitPrice
    maxPrice := close

    // 根据回测模式执行交易
    if backTestMode == "市价模式"
        strategy.entry("多单", strategy.long, qty=positionSize, comment="市价开仓")
        strategy.exit("多单退出", "多单", stop=stopPrice, limit=tpPrice, comment="止盈止损")
    else  // 限价模式
        strategy.entry("多单", strategy.long, limit=smartEntryPrice, qty=positionSize, comment="智能限价开仓")
        strategy.exit("多单退出", "多单", stop=stopPrice, limit=smartExitPrice, comment="智能限价止盈")

    // 绘制标签 - 赛博朋克风格
    if showLabels
        // 止损标签
        drawCyberLabel(time, stopPrice, "止损: " + str.tostring(math.round(stopPrice, 4)), color.new(getNeonColor(bearColor, time), 20), color.white, label.style_label_right, size.small)

        // 止盈标签
        drawCyberLabel(time, tpPrice, "止盈: " + str.tostring(math.round(tpPrice, 4)), color.new(getNeonColor(bullColor, time), 20), color.white, label.style_label_right, size.small)

        // 入场价格标签 - 赛博朋克风格
        entryLabelText = "【入场】: " + str.tostring(math.round(close, 4))
        entryLabelText := entryLabelText + "\n趋势: " + trendStatusText
        entryLabelText := entryLabelText + "\n情绪: " + sentimentBias

        if useCognitiveBias or useReflexivity or useFearGreedIndex
            entryLabelText := entryLabelText + "\n高级信号: "
            if metaBiasScore > 0.5
                entryLabelText := entryLabelText + "认知+ "
            if reflexivityScore > reflexivityThreshold
                entryLabelText := entryLabelText + "反身+ "
            if fearGreedIndex > 0 and fearGreedIndex < fgThreshold
                entryLabelText := entryLabelText + "情绪+ "

        drawCyberLabel(time, close + (atrValue * labelOffset * 0.5), entryLabelText, color.new(getNeonColor(cyberBlue, time), 20), color.white, label.style_label_left, size.small)

    lastTradeBarIndex := bar_index

// === 动态止盈止损逻辑 ===
if strategy.position_size > 0 and (dynamicSL or dynamicTP)
    // 更新最高价格
    maxPrice := math.max(maxPrice, high)

    // 计算当前盈利百分比
    currentProfit = (close - entryPrice) / entryPrice

    if dynamicSL
        // 追踪止损逻辑
        trailingStopPrice = maxPrice - (atrValue * trailingSL)

        // 保本止损逻辑
        breakEvenActive = currentProfit > (breakEvenPct * (tpMultiplier / slMultiplier) / 100)
        breakEvenPrice = entryPrice + (atrValue * 0.2)  // 略高于入场价以覆盖手续费

        // 认知偏差和反身性分析调整止损
        if useCognitiveBias and metaBiasScore < -0.3
            trailingStopPrice := math.min(trailingStopPrice, maxPrice - (atrValue * trailingSL * 0.8))  // 收紧止损
        if useReflexivity and reflexivityScore < -reflexivityThreshold
            trailingStopPrice := math.min(trailingStopPrice, maxPrice - (atrValue * trailingSL * 0.8))  // 收紧止损
        if useFearGreedIndex and fearGreedIndex < -0.3
            trailingStopPrice := math.min(trailingStopPrice, maxPrice - (atrValue * trailingSL * 0.8))  // 收紧止损

        // 更新止损价格
        if trailingStopPrice > stopLossPrice
            stopLossPrice := trailingStopPrice
            strategy.exit("动态止损", "多单", stop=stopLossPrice)
        else if breakEvenActive and breakEvenPrice > stopLossPrice
            stopLossPrice := breakEvenPrice
            strategy.exit("保本止损", "多单", stop=stopLossPrice)

    if dynamicTP
        // 根据RSI调整止盈
        adjustedTP = entryPrice + (atrValue * tpMultiplier * (1 + (trendStrength * 0.5)))

        // 根据市场情绪调整止盈
        if useSentimentAnalysis
            sentimentAdjustment = 1.0 + (sentimentScore * sentimentWeight)
            adjustedTP := adjustedTP * sentimentAdjustment

        // 认知偏差和反身性分析调整止盈
        if useCognitiveBias and metaBiasScore > 0.3
            adjustedTP := adjustedTP * (1 + metaBiasScore * 0.2)  // 增加止盈目标
        if useReflexivity and reflexivityScore > reflexivityThreshold * 0.8
            adjustedTP := adjustedTP * (1 + reflexivityScore * 0.2)  // 增加止盈目标
        if useFearGreedIndex and fearGreedIndex > 0.3
            adjustedTP := adjustedTP * (1 + fearGreedIndex * 0.2)  // 增加止盈目标

        if adjustedTP > takeProfitPrice
            takeProfitPrice := adjustedTP
            strategy.exit("动态止盈", "多单", limit=takeProfitPrice)

// === 动态止盈止损标签 - 赛博朋克风格 ===
if strategy.position_size > 0 and (dynamicSL or dynamicTP) and (bar_index % 5 == 0)  // 每5根K线更新一次标签
    if dynamicSL
        drawCyberLabel(time, stopLossPrice - (atrValue * labelOffset * 0.3), "动态止损: " + str.tostring(math.round(stopLossPrice, 4)), color.new(getNeonColor(bearColor, time), labelOpacity), color.white, label.style_label_right, size.small)

    if dynamicTP
        drawCyberLabel(time, takeProfitPrice + (atrValue * labelOffset * 0.3), "动态止盈: " + str.tostring(math.round(takeProfitPrice, 4)), color.new(getNeonColor(bullColor, time), labelOpacity), color.white, label.style_label_right, size.small)

// === 入场信号可视化 - 赛博朋克风格 ===
// 使用更炫酷的形状和颜色
buySignalColor = getNeonColor(bullColor, time)
plotshape(validLongAfterRisk, "做多入场", style=shape.triangleup, location=location.belowbar, color=buySignalColor, size=size.normal, text="买入", textcolor=color.white)

// === 风险标记 ===
// 在价格图上标注高风险区域
plotshape(riskScore >= 60, title="高风险区域", style=shape.xcross, location=location.abovebar, color=color.new(riskColor, 20), size=size.small)

// === 在K线上标注趋势状态 - 赛博朋克风格 ===
// 使用plotshape代替plotchar，并根据不同趋势状态显示不同形状
strongUptrend = uptrendProb > 70
mildUptrend = uptrendProb > 50 and uptrendProb <= 70
strongDowntrend = downtrendProb > 70
mildDowntrend = downtrendProb > 50 and downtrendProb <= 70
sidewaysMarket = uptrendProb <= 50 and downtrendProb <= 50

// 绘制不同趋势状态的标记 - 赛博朋克风格
plotshape(strongUptrend, title="强势上涨", style=shape.triangleup, location=location.top, color=getNeonColor(bullColor, time), size=size.tiny, text="强势上涨")
plotshape(mildUptrend, title="温和上涨", style=shape.triangleup, location=location.top, color=color.new(getNeonColor(bullColor, time), 40), size=size.tiny, text="温和上涨")
plotshape(strongDowntrend, title="强势下跌", style=shape.triangledown, location=location.top, color=getNeonColor(bearColor, time), size=size.tiny, text="强势下跌")
plotshape(mildDowntrend, title="温和下跌", style=shape.triangledown, location=location.top, color=color.new(getNeonColor(bearColor, time), 40), size=size.tiny, text="温和下跌")
plotshape(sidewaysMarket, title="盘整", style=shape.circle, location=location.top, color=getNeonColor(cyberPurple, time), size=size.tiny, text="盘整")

// === 认知偏差和反身性标记 - 赛博朋克风格 ===
plotshape(metaBiasScore > 0.5, title="正向认知偏差", style=shape.diamond, location=location.top, color=color.new(getNeonColor(cyberBlue, time), 40), size=size.tiny)
plotshape(metaBiasScore < -0.5, title="负向认知偏差", style=shape.diamond, location=location.top, color=color.new(getNeonColor(cyberRed, time), 40), size=size.tiny)
plotshape(reflexivityScore > reflexivityThreshold, title="正向反身性", style=shape.square, location=location.top, color=color.new(getNeonColor(cyberGreen, time), 40), size=size.tiny)
plotshape(reflexivityScore < -reflexivityThreshold, title="负向反身性", style=shape.square, location=location.top, color=color.new(getNeonColor(cyberRed, time), 40), size=size.tiny)

// === 做空方视角分析标签 - 赛博朋克风格 ===
if showShortPerspective and bar_index % 15 == 0  // 每15根K线显示一次做空方视角
    shortAnalysisText = "【做空方视角】"
    shortAnalysisText := shortAnalysisText + "\n入场: " + str.tostring(math.round(shortEntryPrice, 4))
    shortAnalysisText := shortAnalysisText + "\n止损: " + str.tostring(math.round(shortStopPrice, 4))
    shortAnalysisText := shortAnalysisText + "\n止盈: " + str.tostring(math.round(shortTPPrice, 4))
    shortAnalysisText := shortAnalysisText + "\n压力: " + shortConfidence + " (" + str.tostring(math.round(shortPressure, 0)) + "%)"
    shortAnalysisText := shortAnalysisText + "\n理由: " + shortReason

    drawCyberLabel(time, high + (atrValue * labelOffset * 2), shortAnalysisText, color.new(getNeonColor(bearColor, time), labelOpacity), color.white, label.style_label_down, size.small)

// === 多头建议价格标签 - 赛博朋克风格 ===
// 每10根K线显示一次多头建议价格，并添加风险评估
if bar_index % 10 == 0 and showLabels and riskScore < 60  // 只在中等及以下风险时显示多头建议
    longAdviceText = "【多头建议】" + (riskScore >= 40 ? " ⚠️风险: " + riskLevel : "")
    longAdviceText := longAdviceText + "\n入场: " + str.tostring(math.round(suggestedEntryPrice, 4))
    longAdviceText := longAdviceText + "\n止损: " + str.tostring(math.round(suggestedStopLossPrice, 4))
    longAdviceText := longAdviceText + "\n止盈: " + str.tostring(math.round(suggestedTakeProfitPrice, 4))

    if backTestMode == "限价模式"
        longAdviceText := longAdviceText + "\n智能入场: " + str.tostring(math.round(smartEntryPrice, 4))
        longAdviceText := longAdviceText + "\n智能止盈: " + str.tostring(math.round(smartExitPrice, 4))

    // 添加风险评分信息
    if riskScore >= 20
        longAdviceText := longAdviceText + "\n风险评分: " + str.tostring(math.round(riskScore, 0)) + "%"
        if isOverbought
            longAdviceText := longAdviceText + "\n- RSI超买"
        if isPriceOverextended
            longAdviceText := longAdviceText + "\n- 价格过度延伸"
        if isVolatilityHigh
            longAdviceText := longAdviceText + "\n- 波动率过高"
        if isAdxHigh
            longAdviceText := longAdviceText + "\n- 强趋势可能反转"
        if isNearRecentHigh
            longAdviceText := longAdviceText + "\n- 接近近期高点"

    drawCyberLabel(time, low - (atrValue * labelOffset), longAdviceText, color.new(riskScore >= 40 ? riskColor : getNeonColor(bullColor, time), 20), color.white, label.style_label_up, size.small)

// === 交易理由标签 - 赛博朋克风格 ===
// 做多理由标签
if validLongAfterRisk and showLabels
    longReasonText = "【做多理由】"

    if uptrend
        longReasonText := longReasonText + "\n上升趋势"
    if crossUp
        longReasonText := longReasonText + "\nEMA金叉"
    if close > trendLine
        longReasonText := longReasonText + "\n价格高于趋势线"
    if oversold
        longReasonText := longReasonText + "\n超卖反弹"
    if volumeCondition
        longReasonText := longReasonText + "\n成交量放大"
    if sentimentScore > 0
        longReasonText := longReasonText + "\n市场情绪看多"
    if highFreqEntry
        longReasonText := longReasonText + "\n高频交易信号"
    if cognitiveBiasEntry
        longReasonText := longReasonText + "\n认知偏差信号"
    if reflexivityEntry
        longReasonText := longReasonText + "\n反身性信号"
    if fearGreedEntry
        longReasonText := longReasonText + "\n恐惧贪婪信号"

    drawCyberLabel(time, low - (atrValue * labelOffset * 2), longReasonText, color.new(getNeonColor(bullColor, time), labelOpacity), color.white, label.style_label_up, size.small)

// === 市场状态标签 - 赛博朋克风格 ===
// 每20根K线显示一次市场状态
if bar_index % 20 == 0 and showLabels
    marketStatusText = "【市场状态】"
    marketStatusText := marketStatusText + "\n趋势: " + trendStatusText
    marketStatusText := marketStatusText + "\n情绪: " + sentimentBias
    marketStatusText := marketStatusText + "\n多头概率: " + str.tostring(math.round(uptrendProb, 0)) + "%"
    marketStatusText := marketStatusText + "\n空头概率: " + str.tostring(math.round(downtrendProb, 0)) + "%"
    marketStatusText := marketStatusText + "\n波动率: " + str.tostring(math.round(volatility, 2)) + "%"
    marketStatusText := marketStatusText + "\n风险评分: " + str.tostring(math.round(riskScore, 0)) + "%"

    if useCognitiveBias
        marketStatusText := marketStatusText + "\n认知偏差: " + str.tostring(math.round(metaBiasScore * 100, 0)) + "%"
    if useReflexivity
        marketStatusText := marketStatusText + "\n反身性: " + str.tostring(math.round(reflexivityScore * 100, 0)) + "%"
    if useFearGreedIndex
        marketStatusText := marketStatusText + "\n恐惧贪婪: " + fgState

    drawCyberLabel(time, close + (atrValue * labelOffset * 3), marketStatusText, color.new(getNeonColor(cyberPurple, time), labelOpacity), color.white, label.style_label_left, size.small)

// === 支撑阻力位标签 - 赛博朋克风格 ===
if showSR and bar_index % 25 == 0  // 每25根K线显示一次支撑阻力位
    srText = "【支撑阻力位】"
    srText := srText + "\n阻力: " + str.tostring(math.round(nearestResistance, 4))
    srText := srText + "\n支撑: " + str.tostring(math.round(nearestSupport, 4))

    // 避免在breakoutSignal或supportSignal为0时出现NaN
    breakoutProb = breakoutSignal ? math.round(uptrendProb / 100, 2) * 100 : 0
    supportProb = supportSignal ? math.round(downtrendProb / 100, 2) * 100 : 0

    srText := srText + "\n突破概率: " + str.tostring(breakoutProb) + "%"
    srText := srText + "\n破位概率: " + str.tostring(supportProb) + "%"

    drawCyberLabel(time, high + (atrValue * labelOffset * 4), srText, color.new(getNeonColor(cyberYellow, time), labelOpacity), color.white, label.style_label_down, size.small)

// === 预测标签 - 赛博朋克风格 ===
if showPrediction and bar_index % 30 == 0  // 每30根K线显示一次预测
    predictionText = "【价格预测】"
    predictionText := predictionText + "\n预测价格: " + str.tostring(math.round(predictedPrice, 4))
    predictionText := predictionText + "\n预测趋势: " + predictedTrend
    predictionText := predictionText + "\n趋势强度: " + str.tostring(math.round(predictedStrength, 2)) + "%"
    predictionText := predictionText + "\n下一机会: " + nextOpportunityText

    drawCyberLabel(time, low - (atrValue * labelOffset * 4), predictionText, color.new(getNeonColor(cyberBlue, time), labelOpacity), color.white, label.style_label_up, size.small)

// === 认知偏差和反身性分析标签 - 赛博朋克风格 ===
if useCognitiveBias and useReflexivity and bar_index % 35 == 0  // 每35根K线显示一次
    biasText = "【高级分析】"
    biasText := biasText + "\n框架效应: " + str.tostring(math.round(framingEffect * 100, 0)) + "%"
    biasText := biasText + "\n近因偏差: " + str.tostring(math.round(recencyBias * 100, 0)) + "%"
    biasText := biasText + "\n锚定效应: " + str.tostring(math.round(anchoringBias * 100, 0)) + "%"
    biasText := biasText + "\n反身性对齐: " + str.tostring(math.round(reflexivityAlignment * 100, 0)) + "%"
    biasText := biasText + "\n恐惧贪婪: " + fgState

    drawCyberLabel(time, high + (atrValue * labelOffset * 5), biasText, color.new(getNeonColor(cyberPink, time), labelOpacity), color.white, label.style_label_down, size.small)

// === 性能统计 ===
var float totalTrades = 0.0
var float winTrades = 0.0
var float lossTrades = 0.0
var float totalProfit = 0.0
var float maxDrawdown = 0.0
var float currentDrawdown = 0.0
var float peakEquity = 0.0
var float lastEquity = 0.0

// 更新性能统计
if lastEquity != strategy.equity
    // 计算当前回撤
    peakEquity := math.max(peakEquity, strategy.equity)
    currentDrawdown := (peakEquity - strategy.equity) / peakEquity * 100
    maxDrawdown := math.max(maxDrawdown, currentDrawdown)

    // 更新上次权益
    lastEquity := strategy.equity

// 交易统计
if strategy.closedtrades > 0
    totalTrades := strategy.closedtrades
    winTrades := strategy.wintrades
    lossTrades := strategy.losstrades
    totalProfit := strategy.netprofit

// 计算胜率和盈亏比
winRate = totalTrades > 0 ? (winTrades / totalTrades) * 100 : 0.0
profitFactor = lossTrades > 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0

// === 显示性能表格 - 赛博朋克风格 ===
if showTable
    var table performanceTable = table.new(position.top_right, 2, 21, color.new(cyberBackground, 30), color.white, 1, color.new(cyberPurple, 80), 1)

    // 更新表格内容 - 赛博朋克风格
    table.cell(performanceTable, 0, 0, "事前/事后", text_color=color.white, bgcolor=color.new(getNeonColor(cyberBlue, time), 20))
    table.cell(performanceTable, 1, 0, "WhoAreU？你是谁", text_color=color.white, bgcolor=color.new(getNeonColor(cyberBlue, time), 20))

    table.cell(performanceTable, 0, 1, "总交易次数", text_color=color.white)
    table.cell(performanceTable, 1, 1, str.tostring(totalTrades, "#"), text_color=color.white)

    table.cell(performanceTable, 0, 2, "胜率", text_color=color.white)
    table.cell(performanceTable, 1, 2, str.tostring(math.round(winRate, 2)) + "%", text_color=winRate > 50 ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 3, "盈亏比", text_color=color.white)
    table.cell(performanceTable, 1, 3, str.tostring(math.round(profitFactor, 2)), text_color=profitFactor > 1 ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 4, "净利润", text_color=color.white)
    table.cell(performanceTable, 1, 4, str.tostring(math.round(totalProfit, 2)) + "%", text_color=totalProfit > 0 ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 5, "最大回撤", text_color=color.white)
    table.cell(performanceTable, 1, 5, str.tostring(math.round(maxDrawdown, 2)) + "%", text_color=getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 6, "趋势状态", text_color=color.white)
    table.cell(performanceTable, 1, 6, trendStatusText, text_color=uptrendProb > downtrendProb ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 7, "市场情绪", text_color=color.white)
    table.cell(performanceTable, 1, 7, sentimentBias, text_color=sentimentScore > 0 ? getNeonColor(bullColor, time) : sentimentScore < 0 ? getNeonColor(bearColor, time) : color.white)

    table.cell(performanceTable, 0, 8, "做空压力", text_color=color.white)
    table.cell(performanceTable, 1, 8, shortConfidence + " (" + str.tostring(math.round(shortPressure, 0)) + "%)", text_color=shortPressure > 50 ? getNeonColor(bearColor, time) : getNeonColor(bullColor, time))

    table.cell(performanceTable, 0, 9, "认知偏差", text_color=color.white)
    table.cell(performanceTable, 1, 9, str.tostring(math.round(metaBiasScore * 100, 0)) + "%", text_color=metaBiasScore > 0 ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 10, "反身性", text_color=color.white)
    table.cell(performanceTable, 1, 10, str.tostring(math.round(reflexivityScore * 100, 0)) + "%", text_color=reflexivityScore > 0 ? getNeonColor(bullColor, time) : getNeonColor(bearColor, time))

    table.cell(performanceTable, 0, 11, "下一机会", text_color=color.white)
    table.cell(performanceTable, 1, 11, nextOpportunityText, text_color=color.white)

    // 添加回测模式信息
    table.cell(performanceTable, 0, 12, "回测模式", text_color=color.white)
    table.cell(performanceTable, 1, 12, backTestMode, text_color=getNeonColor(cyberPurple, time))

    // 添加多头建议价格信息
    table.cell(performanceTable, 0, 13, "【想[多]】", text_color=getNeonColor(cyberBlue, time))
    table.cell(performanceTable, 1, 13, "入场/止损/止盈", text_color=getNeonColor(cyberBlue, time))

    table.cell(performanceTable, 0, 14, "价格", text_color=color.white)
    table.cell(performanceTable, 1, 14, str.tostring(math.round(suggestedEntryPrice, 4)) + "/" + str.tostring(math.round(suggestedStopLossPrice, 4)) + "/" + str.tostring(math.round(suggestedTakeProfitPrice, 4)), text_color=color.white)

    // 添加做空方价格信息
    table.cell(performanceTable, 0, 15, "【想[空]】", text_color=getNeonColor(cyberRed, time))
    table.cell(performanceTable, 1, 15, "入场/止损/止盈", text_color=getNeonColor(cyberRed, time))

    table.cell(performanceTable, 0, 16, "价格", text_color=color.white)
    table.cell(performanceTable, 1, 16, str.tostring(math.round(shortEntryPrice, 4)) + "/" + str.tostring(math.round(shortStopPrice, 4)) + "/" + str.tostring(math.round(shortTPPrice, 4)), text_color=color.white)

    // 添加智能限价信息
    table.cell(performanceTable, 0, 17, "【永恒买卖】", text_color=getNeonColor(cyberPurple, time))
    table.cell(performanceTable, 1, 17, str.tostring(math.round(smartEntryPrice, 4)) + "/" + str.tostring(math.round(smartExitPrice, 4)), text_color=backTestMode == "限价模式" ? getNeonColor(cyberYellow, time) : color.white)

    // 添加风险评估行
    table.cell(performanceTable, 0, 18, "风险评估", text_color=color.white)
    table.cell(performanceTable, 1, 18, riskLevel + " (" + str.tostring(math.round(riskScore, 0)) + "%)", text_color=riskColor)

    // 添加当前回撤行
    table.cell(performanceTable, 0, 19, "当前回撤", text_color=color.white)
    table.cell(performanceTable, 1, 19, str.tostring(math.round(currentGlobalDrawdown, 2)) + "%", text_color=currentGlobalDrawdown > maxDrawdownLimit ? getNeonColor(cyberRed, time) : color.white)

    // 添加风险具体因素
    riskFactors = ""
    if isOverbought
        riskFactors := riskFactors + "RSI超买 "
    if isPriceOverextended
        riskFactors := riskFactors + "价格延伸 "
    if isVolatilityHigh
        riskFactors := riskFactors + "高波动 "
    if isAdxHigh
        riskFactors := riskFactors + "ADX高 "
    if isNearRecentHigh
        riskFactors := riskFactors + "近高点 "

    if riskFactors == ""
        riskFactors := "无特殊风险"

    table.cell(performanceTable, 0, 20, "风险因素", text_color=color.white)
    table.cell(performanceTable, 1, 20, riskFactors, text_color=riskScore >= 40 ? riskColor : color.white)
