# ============================================================================
# freqtrade-data-service · .env template
# ============================================================================
# Usage:   cp .env.example .env  &&  edit .env
# Note:    .env is gitignored. Never commit secrets.
# Legend:  # REQUIRED  = must set before deploy        # OPTIONAL = safe default exists
# ============================================================================

# --- Docker / Compose ---------------------------------------------------------
# Override on x86_64 hosts (e.g. Bulgarian VPS): DOCKER_PLATFORM=linux/amd64
DOCKER_PLATFORM=linux/arm64                           # OPTIONAL (default: linux/arm64 for Mac M-series)

# Where ClickHouse persists data on the host. Override for production.
CLICKHOUSE_DATA_DIR=/Volumes/FORGE/data/clickhouse    # OPTIONAL (override on Linux: /data/clickhouse)

# Container timezone (logs / cron-style services).
TZ=Asia/Shanghai                                      # OPTIONAL

# --- ClickHouse Database ------------------------------------------------------
# When running locally outside Docker, point to localhost.
# When running in docker-compose, the service name `clickhouse-db` is the host.
CLICKHOUSE_HOST=clickhouse-db                         # REQUIRED (use `localhost` if not in compose network)
CLICKHOUSE_PORT=8123                                  # OPTIONAL (HTTP port for aiochclient)
CLICKHOUSE_DATABASE=crypto_data                       # OPTIONAL
CLICKHOUSE_USER=default                               # OPTIONAL
CLICKHOUSE_PASSWORD=                                  # OPTIONAL (empty = no auth, dev only)
# Host port mappings — override on shared hosts to avoid port clashes
CLICKHOUSE_HTTP_PORT=8123                             # OPTIONAL (host port mapped to container 8123)
CLICKHOUSE_NATIVE_PORT=9000                           # OPTIONAL (host port mapped to container 9000)

# --- API Service --------------------------------------------------------------
API_HOST=0.0.0.0                                      # OPTIONAL
API_PORT=8000                                         # OPTIONAL (in-container port)
WS_PORT=8001                                          # OPTIONAL (in-container port)
API_HOST_PORT=8000                                    # OPTIONAL (host port mapped to container API)
WS_HOST_PORT=8001                                     # OPTIONAL (host port mapped to container WS)
LOG_LEVEL=INFO                                        # OPTIONAL (DEBUG/INFO/WARNING/ERROR)
DEBUG=false                                           # OPTIONAL

# --- Data Collection ----------------------------------------------------------
# Comma-separated. Currently only `binance` is fully supported.
ENABLED_EXCHANGES=binance                             # OPTIONAL

# Symbols to track. ALL = every USDT-perpetual contract from each enabled exchange.
SYMBOLS=ALL                                           # OPTIONAL (or e.g. BTC/USDT,ETH/USDT)

# Comma-separated timeframes for kline subscription.
TIMEFRAMES=1m,5m,15m,1h,4h,1d                         # OPTIONAL

# --- Data Retention (TTL in days, per timeframe) ------------------------------
TTL_1M=7                                              # OPTIONAL
TTL_5M=30                                             # OPTIONAL
TTL_15M=90                                            # OPTIONAL
TTL_1H=365                                            # OPTIONAL
TTL_4H=365                                            # OPTIONAL
TTL_1D=1825                                           # OPTIONAL

# --- Recovery (REST API gap-fill) ---------------------------------------------
RECOVERY_CHECK_INTERVAL=60                            # OPTIONAL (seconds)
MAX_GAP_MINUTES=720                                   # OPTIONAL (12h max single-call backfill)
RECOVERY_SYMBOLS_PER_CYCLE=50                         # OPTIONAL

# --- WebSocket -----------------------------------------------------------------
MAX_SYMBOLS_PER_WS_CONNECTION=100                     # OPTIONAL
MAX_TOTAL_SYMBOLS=475                                 # OPTIONAL (Binance USDT-perp count, ~475)
ENABLE_ALL_SYMBOLS=true                               # OPTIONAL
MAX_WEBSOCKET_CONNECTIONS=1000                        # OPTIONAL (upper bound, hardware-dependent)

# --- Optional: Exchange API Keys (only needed for REST backup) -----------------
# Leave commented unless you actually want REST recovery beyond public endpoints.
# BINANCE_API_KEY=
# BINANCE_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=
# BYBIT_API_KEY=
# BYBIT_SECRET=

# --- Binance Network Proxy (deployments behind a proxy) ---------------------
# Empty = direct connection. SOCKS5h example for jarvis Mac mini behind v2rayN:
# BINANCE_PROXY_URL=socks5h://host.docker.internal:10808
BINANCE_PROXY_URL=                                    # OPTIONAL (default: direct)

# --- Business Module Configuration — NOT IN THIS REPO ----------------------
# After cleanup-business-modules (2026-05-13), data-service is a pure data
# relay. Detection / classification / Telegram-alert configuration lives in:
#   - volume-monitor/.env.example   (DETECTION_*, CLASSIFICATION_*)
#   - telegram-bot/.env.example     (TELEGRAM_BOT_TOKEN, TELEGRAM_*, etc.)
# Do NOT add TELEGRAM_*, DETECTION_*, CLASSIFICATION_*, or ALERTS_* keys here.

# --- NATS Event Bus (introduce-nats-event-bus) ------------------------------
# data-service publishes K-line events to subject `ohlcv.{exchange}.{symbol}.{tf}`
# after each successful ClickHouse insert. Downstream consumers (volume-monitor,
# telegram-bot) subscribe to drive event-driven workflows.
NATS_URL=nats://nats:4222                             # In-cluster URL; for local dev outside compose use nats://localhost:4222
NATS_ENABLE=true                                      # OPTIONAL (false = no-op the publisher; insert path stays normal)
