# ClickHouse Database Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=crypto_data
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
WS_PORT=8001
LOG_LEVEL=INFO
DEBUG=false

# Data Collection Settings
# Exchanges to enable (comma separated)
ENABLED_EXCHANGES=binance,okx,bybit

# Symbols to track (comma separated, or "ALL" for all available)
# Example: BTCUSDT,ETHUSDT,BNBUSDT
SYMBOLS=ALL

# Timeframes to collect (comma separated)
TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Data Retention Policy (days)
TTL_1M=7
TTL_5M=30
TTL_15M=90
TTL_1H=365
TTL_4H=365
TTL_1D=1825

# Recovery Settings
# Check interval in seconds
RECOVERY_CHECK_INTERVAL=60
# Max gap to fill via REST API (minutes)
MAX_GAP_MINUTES=240

# WebSocket Settings
MAX_SYMBOLS_PER_WS_CONNECTION=100
MAX_TOTAL_SYMBOLS=475
ENABLE_ALL_SYMBOLS=true
MAX_WEBSOCKET_CONNECTIONS=1000

# Optional: Exchange API Keys (for REST API backup)
# Only needed if you want to use REST API for data recovery
# BINANCE_API_KEY=
# BINANCE_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=
# BYBIT_API_KEY=
# BYBIT_SECRET=